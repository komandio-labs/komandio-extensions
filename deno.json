{
  "minimumDependencyAge": 0,
  "imports": {
    "std/": "jsr:@std/",
    "@komandio/sdk": "jsr:@komandio/sdk@1.0.0",
    "@komandio/sdk/fuzzy": "jsr:@komandio/sdk@1.0.0/fuzzy"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --no-check extensions/",
    "dev": "deno run -A tools/devkit.ts",
    "build-all": "deno run -A tools/build-all.ts",
    "deploy-local": "deno run -A tools/deploy-local.ts"
  }
}
